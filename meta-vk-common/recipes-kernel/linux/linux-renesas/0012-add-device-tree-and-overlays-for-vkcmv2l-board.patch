From 56f58a805d87f29b35e5e7c58ef618598420686e Mon Sep 17 00:00:00 2001
From: dtodoroff <d.todorov@vekatech.com>
Date: Wed, 23 Jul 2025 16:13:24 +0300
Subject: [PATCH 12/16] add device tree and overlays for vkcmv2l board


diff --git a/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/Makefile b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/Makefile
new file mode 100644
index 000000000000..365bc5346e3b
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/Makefile
@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: GPL-2.0
+
+# required for overlay support
+DTC_FLAGS += -@
+
+dtb-y += vkcmx2l-carrier.dtbo
+dtb-y += vkrz-dsi-kd070hdfia030.dtbo
+dtb-y += vkrz-dsi-kd101wxfid045.dtbo
+dtb-y += vkrz-exp-riic2_100.dtbo
+dtb-y += vkrz-exp-riic2_400.dtbo
+dtb-y += vkrz-exp-rspi1.dtbo
+dtb-y += vkrz-exp-scfi3.dtbo
+
diff --git a/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkcmv2l-ov5640.dts b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkcmv2l-ov5640.dts
new file mode 100644
index 000000000000..2c40b2d8f298
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkcmv2l-ov5640.dts
@@ -0,0 +1,45 @@
+/*
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ */
+
+/dts-v1/;
+/plugin/;
+
+&cru {
+	status = "okay";
+};
+
+&csi2 {
+	status = "okay";
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		port@0 {
+			reg = <0>;
+			csi2_in: endpoint {
+				clock-lanes = <0>;
+				data-lanes = <1 2>;
+				remote-endpoint = <&ov5640_to_csi>;
+			};
+		};
+	};
+};
+
+&ov5640 {
+	status = "okay";
+	port {
+		ov5640_to_csi: endpoint {
+			clock-lanes = <0>;
+			data-lanes = <1 2>;
+			remote-endpoint = <&csi2_in>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkcmx2l-carrier.dts b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkcmx2l-carrier.dts
new file mode 100644
index 000000000000..1114e0109d1c
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkcmx2l-carrier.dts
@@ -0,0 +1,142 @@
+/*
+ * Copyright 2023 Vekatech
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License
+ * as published by the Free Software Foundation; either version 2
+ * of the License, or (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU General Public License for more details.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/input/input.h>
+
+/dts-v1/;
+/plugin/;
+
+/*
+/{
+	compatible = "vekatech,vkcmv2l", 
+	             "renesas,r9a07g054l2", 
+		     "renesas,r9a07g054";
+};
+*/
+
+#define AUDIO	1
+#define CANFD	1
+#define RS485	1
+#define ADC	1
+
+#if RS485
+/* RS-485 */
+&scif2 {
+	pinctrl-0 = <&scif2_pins>;
+	pinctrl-names = "default";
+
+	rs485-sw-rts;
+	gpios = <&pinctrl RZG2L_GPIO( 48, 3) GPIO_ACTIVE_LOW>;
+	status = "okay";
+};
+#endif
+
+
+#if ADC
+/* ADC */
+&adc {
+	pinctrl-0 = <&adc_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	/delete-node/ channel@6;
+	/delete-node/ channel@7;
+};
+#endif
+
+#if CANFD
+/* CANFD  */
+&canfd {
+	pinctrl-0 = <&can0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	/*renesas,no-can-fd;*/
+
+	channel0 {
+		renesas,channel = <0>;
+		status = "okay";
+	};
+};
+#endif
+
+#if AUDIO
+/* Audio */
+
+&sound_codec {
+	status = "okay";
+};
+
+&ssi0 {
+	pinctrl-0 = <&ssi0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&max9867 {
+	status = "okay";
+};
+#endif
+
+
+&pinctrl {
+#if ADC
+	adc_pins: adc {
+		pinmux = <RZG2L_PORT_PINMUX(9, 0, 2)>; /* ADC_TRG */
+	};
+#endif
+
+#if RS485
+	rs485_pwren {
+		gpio-hog;
+		gpios = <RZG2L_GPIO( 48, 2) GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "rs485_pwren";
+	};
+
+	scif2_pins: scif2 {
+		pinmux = <RZG2L_PORT_PINMUX(48, 0, 1)>, /* TxD */
+			 <RZG2L_PORT_PINMUX(48, 1, 1)>; /* RxD */
+	};
+#endif
+
+#if CANFD
+	can0_stby {
+		gpio-hog;
+		gpios = <RZG2L_GPIO(11, 1) GPIO_ACTIVE_LOW>;
+		output-high;
+		line-name = "can0_stby";
+	};
+
+	can0_pins: can0 {
+		pinmux = <RZG2L_PORT_PINMUX(10, 1, 2)>, /* TX */
+			 <RZG2L_PORT_PINMUX(11, 0, 2)>; /* RX */
+	};
+#endif
+
+#if AUDIO
+	ssi0_pins: ssi0 {
+		pinmux = <RZG2L_PORT_PINMUX(45, 0, 1)>, /* BCK */
+			 <RZG2L_PORT_PINMUX(45, 1, 1)>, /* RCK */
+			 <RZG2L_PORT_PINMUX(45, 2, 1)>, /* TXD */
+			 <RZG2L_PORT_PINMUX(45, 3, 1)>; /* RXD */
+	};
+#endif
+};
+
diff --git a/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkrz-dsi-kd070hdfia030.dts b/arch/arm64/boot/dts/renesas/overlays-vkcmv2l/vkrz-dsi-kd070hdfia030.dts
new file mode 100644
