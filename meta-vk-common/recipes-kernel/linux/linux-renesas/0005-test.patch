From 99a82958ff2fa0bad7751afa9a593bc70e194752 Mon Sep 17 00:00:00 2001
From: Stanimir Bonev <stanimir@x-cas.eu>
Date: Sat, 5 Apr 2025 15:13:40 +0300
Subject: [PATCH] test

---
 drivers/bluetooth/hci_bcm.c | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/drivers/bluetooth/hci_bcm.c b/drivers/bluetooth/hci_bcm.c
index 3f6e96a4e114..2a535dae5b4d 100644
--- a/drivers/bluetooth/hci_bcm.c
+++ b/drivers/bluetooth/hci_bcm.c
@@ -1511,19 +1511,34 @@ static struct serdev_device_driver bcm_serdev_driver = {

 int __init bcm_init(void)
 {
+	// ala = bala;
+	int rc;
 	/* For now, we need to keep both platform device
 	 * driver (ACPI generated) and serdev driver (DT).
 	 */
 	platform_driver_register(&bcm_driver);
+	bt_info("=== %s:%s BCM Bluetooth driver enter\n", __FILE__, __func__);
 	serdev_device_driver_register(&bcm_serdev_driver);
-
-	return hci_uart_register_proto(&bcm_proto);
+	rc = hci_uart_register_proto(&bcm_proto);
+	if (rc) {
+		bt_err("=== %s:%s BCM Bluetooth driver  - Failed to register BCM protocol (%d)", __FILE__, __func__, rc);
+	} else {
+		bt_info("=== %s:%s BCM Bluetooth driver  - Registered BCM protocol\n", __FILE__, __func__);
+	}
+	return rc;
 }

 int __exit bcm_deinit(void)
 {
+	int rc;
+	bt_info("=== %s:%s BCM Bluetooth driver exit\n", __FILE__, __func__);
 	platform_driver_unregister(&bcm_driver);
 	serdev_device_driver_unregister(&bcm_serdev_driver);
-
-	return hci_uart_unregister_proto(&bcm_proto);
+	rc = hci_uart_unregister_proto(&bcm_proto);
+	if (rc) {
+		bt_err("=== %s:%s BCM Bluetooth driver  - Failed to unregister BCM protocol (%d)", __FILE__, __func__, rc);
+	} else {
+		bt_info("=== %s:%s BCM Bluetooth driver  - Unregistered BCM protocol\n", __FILE__, __func__);
+	}
+	return rc;
 }
