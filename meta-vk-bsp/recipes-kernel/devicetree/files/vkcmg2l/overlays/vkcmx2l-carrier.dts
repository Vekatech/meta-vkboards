#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>

/dts-v1/;
/plugin/;


#define AUDIO	1
#define CANFD	1
#define RS485	0
#define RS485_ON_OFF 0
#define ADC	1


/{
	compatible = "vekatech,vkcmg2l", 
	             "renesas,r9a07g044l2", 
		     "renesas,r9a07g044";
};

&{/} {
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";

		led_red {
			gpios = <&pinctrl RZG2L_GPIO(6, 1) GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_green {
			gpios = <&pinctrl RZG2L_GPIO(17, 0) GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_blue {
			gpios = <&pinctrl RZG2L_GPIO(15, 1) GPIO_ACTIVE_HIGH>;
			default-state = "on";
			linux,default-trigger = "heartbeat";
		};

		led_yellow {
			gpios = <&pinctrl RZG2L_GPIO(16, 0) GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys";
		user_key_1 {
			label = "SW4";
			linux,code = <KEY_1>;
			debounce-interval = <20>;
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(3, 0) IRQ_TYPE_LEVEL_LOW>;
		};

		user_key_2 {
			label = "SW5";
			linux,code = <KEY_2>;
			debounce-interval = <20>;
			interrupt-parent = <&pinctrl>;
			interrupts = <RZG2L_GPIO(3, 1) IRQ_TYPE_LEVEL_LOW>;
		};
	};
};

#if AUDIO
/* Audio */
&{/} {
	sound_codec: sound-max9867 {
		compatible = "simple-audio-card";
		simple-audio-card,name = "audio-max9867";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&cpu_dai>;
		simple-audio-card,frame-master = <&cpu_dai>;
		status = "okay";

		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,widgets =
			"Headphone", "Headset Headphone",
			"Microphone", "Headset Microphone";

		simple-audio-card,routing =
			"Headset Headphone", "LOUT",
			"Headset Headphone", "ROUT",
			"MICL", "Headset Microphone";

		cpu_dai: simple-audio-card,cpu {
			sound-dai = <&ssi0>;
		};

		codec_dai: simple-audio-card,codec {
			sound-dai = <&max9867>;
			clocks = <&audio_mclock>;
			system-clock-fixed;
		};
	};
};

&ssi0 {
	pinctrl-0 = <&ssi0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c3 {
	/* MAX9867 Codec */
	max9867: codec@18 {
		compatible = "maxim,max9867";
		#sound-dai-cells = <0>;
		reg = <0x18>;
		clocks = <&audio_mclock>;
		clock-names = "mclk";
		status = "okay";
	};
};

&pinctrl {
	ssi0_pins: ssi0 {
		pinmux = <RZG2L_PORT_PINMUX(45, 0, 1)>, /* BCK */
			 <RZG2L_PORT_PINMUX(45, 1, 1)>, /* RCK */
			 <RZG2L_PORT_PINMUX(45, 2, 1)>, /* TXD */
			 <RZG2L_PORT_PINMUX(45, 3, 1)>; /* RXD */
	};
};

#endif

#if RS485
/* RS-485 */

#if RS485_ON_OFF

&{/} {
    /* DC-DC */
    reg_rs485_iso: regulator-rs485-iso {
        compatible = "regulator-fixed";
        regulator-name = "rs485-isolated-vcc";
        
        /* DC-DC enable GPIO 48_2 */
        gpio = <&pinctrl RZG2L_GPIO(48, 2) GPIO_ACTIVE_HIGH>;
        enable-active-high;

	startup-delay-us = <50000>;
    };
};

#else

&pinctrl {
    scif2_iso_pwr_pins: scif2-iso-pwr {
        pinmux = <RZG2L_PORT_PINMUX(48, 2, 0)>; /* GPIO */
    };

    scif2-iso-pwr-hog {
        gpio-hog;
        gpios = <RZG2L_GPIO(48, 2) GPIO_ACTIVE_HIGH>; 
        output-high;                   /* Set logic 1 */
        line-name = "rs485-iso-pwr-en";
    };

#endif

&scif2 {
	pinctrl-names = "default";
	pinctrl-0 = <&scif2_pins>, <&scif2_rs485_de>;
	status = "okay";

	#if RS485_ON_OFF
	vcc-supply = <&reg_rs485_iso>;
	#endif

	rts-gpios = <&pinctrl RZG2L_GPIO( 48, 3) GPIO_ACTIVE_HIGH>;
	linux,rs485-enabled-at-boot-time;
	/* rs485-rts-delay = <1 1>; */ /* [delay before TX] [delay after TX] */
};

&pinctrl {
	scif2_pins: scif2 {
		pinmux = <RZG2L_PORT_PINMUX(48, 0, 1)>, /* TxD */
			 <RZG2L_PORT_PINMUX(48, 1, 1)>; /* RxD */
	};

	scif2_rs485_de: scif2-rs485-de {
		pinmux = <RZG2L_PORT_PINMUX(48, 3, 0)>; /* GPIO */
	};
};

#endif


#if ADC
/* ADC */
&adc {
	pinctrl-0 = <&adc_pins>;
	pinctrl-names = "default";
	status = "okay";

	/delete-node/ channel@6;
	/delete-node/ channel@7;
};

&pinctrl {
	adc_pins: adc {
		pinmux = <RZG2L_PORT_PINMUX(9, 0, 2)>; /* ADC_TRG */
	};
};
#endif

#if CANFD
/* CANFD  */
&canfd {
	pinctrl-0 = <&can0_pins>;
	pinctrl-names = "default";
	status = "okay";

	/*renesas,no-can-fd;*/

	channel0 {
		renesas,channel = <0>;
		status = "okay";
	};
};

&pinctrl {
	can0_stby {
		gpio-hog;
		gpios = <RZG2L_GPIO(11, 1) GPIO_ACTIVE_LOW>;
		output-high;
		line-name = "can0_stby";
	};

	can0_pins: can0 {
		pinmux = <RZG2L_PORT_PINMUX(10, 1, 2)>, /* TX */
			 <RZG2L_PORT_PINMUX(11, 0, 2)>; /* RX */
	};
};

#endif


