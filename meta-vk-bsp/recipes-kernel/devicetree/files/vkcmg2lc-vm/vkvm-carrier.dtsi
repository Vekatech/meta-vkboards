#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>

#include "vkvm-carrier-pins.dtsi"

/ {
/*LED */
	leds:leds {
		compatible = "gpio-leds";
		led_act:led-act {
			linux,default-trigger = "heartbeat";
			gpios = <&pinctrl RZG2L_GPIO(43, 2) GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};
/* Audio */
	sound_codec: sound-max9867 {
		compatible = "simple-audio-card";
		simple-audio-card,name = "audio-max9867";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&cpu_dai>;
		simple-audio-card,frame-master = <&cpu_dai>;
		status = "okay";

		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,widgets =
			"Headphone", "Headset Headphone",
			"Microphone", "Headset Microphone";

		simple-audio-card,routing =
			"Headset Headphone", "LOUT",
			"Headset Headphone", "ROUT",
			"MICL", "Headset Microphone";

		cpu_dai: simple-audio-card,cpu {
			sound-dai = <&ssi0>;
		};

		codec_dai: simple-audio-card,codec {
			sound-dai = <&max9867>;
			clocks = <&audio_mclock>;
			system-clock-fixed;
		};
	};
};

&ssi0 {
	pinctrl-0 = <&ssi0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* USBs */
&ehci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&ohci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&ehci1 {
	memory-region = <&global_cma>;
	status = "okay";
};

&ohci1 {
	memory-region = <&global_cma>;
	status = "okay";
};

&hsusb {
	dr_mode = "otg";
	status = "okay";
};

&phyrst {
	status = "okay";
};

&usb2_phy0 {
	pinctrl-0 = <&usb0_pins>;
	pinctrl-names = "default";

	vbus-supply = <&vbus0_5v>;
	status = "okay";
};

&usb2_phy1 {
	pinctrl-0 = <&usb1_pins>;
	pinctrl-names = "default";

	vbus-supply = <&vbus0_5v>;
	status = "okay";
};

&i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	/* MAX9867 Codec */
	max9867: codec@18 {
		compatible = "maxim,max9867";
		#sound-dai-cells = <0>;
		reg = <0x18>;
		clocks = <&audio_mclock>;
		clock-names = "mclk";
		status = "okay";
	};
};



