/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/{
	compatible = "vekatech,vk-vmcarrier", 
	             "renesas,r9a07g044l2", 
		     "renesas,r9a07g044";
};


&{/} {
	wifi_pwrseq: wifi_pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&pinctrl RZG2L_GPIO(23, 1) GPIO_ACTIVE_LOW>;
	};
};

&scif1 {
	status = "okay";

	pinctrl-0 = <&scif1_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	bluetooth: bluetooth@0 {
		status = "okay";

		compatible = "brcm,bcm43438-bt";
		vbat-supply = <&reg_3p3v>;
		vddio-supply = <&reg_3p3v>;
		shutdown-gpios = <&pinctrl RZG2L_GPIO(23, 0) GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&pinctrl RZG2L_GPIO(22, 1) GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl>;
		interrupts = <RZG2L_GPIO(27, 0) IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wakeup";
		clocks = <&osc_32k>;
		clock-names = "lpo";
		max-speed = <4000000>;

		// #sound-dai-cells = <0>;
		// brcm,bt-pcm-int-params	= [01 02 00 01 01];
	};
};

&sdhi1 {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-names = "default";
	pinctrl-0 = <&wifi_pins>;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&vccq_sdhi1>;
	bus-width = <4>;
	non-removable;
	mmc-pwrseq = <&wifi_pwrseq>;
        cap-sd-highspeed;
	cap-power-off-card;
	keep-power-in-suspend;

	brcmf: bcrmf@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
		status = "okay";
		interrupt-parent = <&pinctrl>;
		interrupts = <RZG2L_GPIO(40, 2) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
	};

};

&pinctrl {
	scif1_pins: scif1 {
		pinmux = <RZG2L_PORT_PINMUX(40, 0, 1)>, /* TxD */
			 <RZG2L_PORT_PINMUX(40, 1, 1)>, /* RxD */
			 <RZG2L_PORT_PINMUX(41, 0, 1)>, /* CTS# */
			 <RZG2L_PORT_PINMUX(41, 1, 1)>; /* RTS# */
	};

	wifi_pins: wifi {
		wifi_data {
			pins = "SD1_DATA0", "SD1_DATA1", "SD1_DATA2", "SD1_DATA3";
			power-source  = <3300>;
		};

		wifi_ctrl {
			pins = "SD1_CLK", "SD1_CMD";
			power-source  = <3300>;
		};
	};
};

