#define I2C	1
#define SPI	0


/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "vekatech,vkrzg2lc", "renesas,r9a07g044", "renesas,r9a07g044c2";
};

#if 1

&{/} {
	vcc_mcp23x17: regulator-mcp23x17 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-mcp23x17";

		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;

		gpio = <&pinctrl RZG2L_GPIO(40, 2) GPIO_ACTIVE_HIGH>;
		enable-active-high;

		startup-delay-us = <50000>;

		/*
		 * Keep the expander supply enabled throughout operation.
		 */
		regulator-always-on;
		regulator-boot-on;
        vin-supply = <&reg_5p0v>;
	};

};

#else 

&pinctrl {
	mcp23017_power_enable {
		gpio-hog;
		gpios = <RZG2L_GPIO(40, 2) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "mcp23017-power-enable";
	};
};

#endif

&pinctrl {
	mcp23017_reset_deassert {
		gpio-hog;
		gpios = <RZG2L_GPIO(39, 2) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "mcp23017-reset";
	};
};

&leds {
		pinctrl-names = "default";
		led_kbe_act {
			gpios = <&pinctrl RZG2L_GPIO(39, 1) GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
};

#if I2C
 
&pinctrl {
	i2c3_pins: i2c3 {
		pinmux = <RZG2L_PORT_PINMUX(18, 0, 3)>, /* SDA */
			 <RZG2L_PORT_PINMUX(18, 1, 3)>; /* SCL */
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	gpio_expander_1: gpio@20 {
		compatible = "microchip,mcp23017";
		reg = <0x20>;

		/*reset-gpios = <&pinctrl RZG2L_GPIO(39, 2) GPIO_ACTIVE_LOW>;*/

		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"P1",  "P2",  "P3",  "P4",
			"P5",  "P6",  "P7",  "P8",
			"P9",  "P10", "P11", "P12",
			"P13", "P14", "P15", "P16";

		status = "okay";
	};

	gpio_expander_2: gpio@21 {
		compatible = "microchip,mcp23017";
		reg = <0x21>;

        /*reset-gpios = <&pinctrl RZG2L_GPIO(39, 2) GPIO_ACTIVE_LOW>;*/

		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"P17", "P18", "P19", "P20",
			"P21", "P22", "P23", "P24",
			"P25", "P26", "P27", "P28",
			"P29", "P30", "P31", "P32";

		status = "okay";
	};
};
#endif

#if SPI

&pinctrl {
	spi1_pins: spi1 {
		pinmux = <RZG2L_PORT_PINMUX(44, 0, 1)>, /* CK */
			 <RZG2L_PORT_PINMUX(44, 1, 1)>, /* MOSI */
			 <RZG2L_PORT_PINMUX(44, 2, 1)>, /* MISO */
			 <RZG2L_PORT_PINMUX(44, 3, 1)>; /* SSL */
	};

&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";

	status = "okay";

	gpio_expanders: gpio@0 {
		compatible = "microchip,mcp23s17";
		gpio-controller;
		#gpio-cells = <2>;


		/* SPI1 chip-select 0 */
		reg = <0>;

		spi-max-frequency = <10000000>;

		/*
		 * MCP23S17 hardware addresses present on this CS:
		 *
		 * bit 0 = A2:A0 = 000, equivalent to I2C 0x20
		 * bit 1 = A2:A0 = 001, equivalent to I2C 0x21
		 */
		microchip,spi-present-mask = <0x03>;

		/* Shared reset for both physical devices. */
		reset-gpios = <&pinctrl RZG2L_GPIO(39, 2) GPIO_ACTIVE_LOW>;
	};
};



};


#endif
