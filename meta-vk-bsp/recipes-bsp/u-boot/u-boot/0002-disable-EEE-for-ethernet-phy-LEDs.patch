From cf3a6e00cc3859d87c78b75f2d68d0cece7fb7d3 Mon Sep 17 00:00:00 2001
From: dtodoroff <d.todorov@vekatech.com>
Date: Wed, 12 Aug 2026 10:24:45 +0300
Subject: [PATCH 2/9] disable EEE for ethernet phy LEDs


diff --git a/drivers/net/phy/realtek.c b/drivers/net/phy/realtek.c
index 7e1036b227..3e4bafd204 100644
--- a/drivers/net/phy/realtek.c
+++ b/drivers/net/phy/realtek.c
@@ -262,6 +262,7 @@ static int rtl8211f_config(struct phy_device *phydev)
 	phy_write(phydev, MDIO_DEVAD_NONE,
 		  MIIM_RTL8211F_PAGE_SELECT, 0xd04);
 	phy_write(phydev, MDIO_DEVAD_NONE, 0x10, 0x617f);
+        phy_write(phydev, MDIO_DEVAD_NONE, 0x11, 0x0000); /*Disable EEE LED indication*/
 	phy_write(phydev, MDIO_DEVAD_NONE,
 		  MIIM_RTL8211F_PAGE_SELECT, 0x0);
 
