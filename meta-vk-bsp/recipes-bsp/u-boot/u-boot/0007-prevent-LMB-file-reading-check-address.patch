From: dtodoroff <d.todorov@vekatech.com>
Date: Wed, 12 Aug 2026 10:40:20 +0300
Subject: [PATCH 7/9] prevent LMB file reading check address


diff --git a/fs/fs.c b/fs/fs.c
index acf465bdd8..479a9940b7 100644
--- a/fs/fs.c
+++ b/fs/fs.c
@@ -555,9 +555,12 @@ static int fs_read_lmb_check(const char *filename, ulong addr, loff_t offset,
 
 	if (lmb_alloc_addr(&lmb, addr, read_len) == addr)
 		return 0;
-
+#if 1
+	return 0;
+#else 
 	log_err("** Reading file would overwrite reserved memory **\n");
 	return -ENOSPC;
+#endif 
 }
 #endif
 
