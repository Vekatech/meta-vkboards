From 51d86242474264591531ccdd4765c8395d039aa2 Mon Sep 17 00:00:00 2001
From: dtodoroff <d.todorov@vekatech.com>
Date: Wed, 12 Aug 2026 10:34:05 +0300
Subject: [PATCH 5/9] fastboot: add CONFIG_USB_EPMAXPACK_FASTBOOT option while
 USB receiving


diff --git a/drivers/fastboot/Kconfig b/drivers/fastboot/Kconfig
index 70207573de..2ae56ed722 100644
--- a/drivers/fastboot/Kconfig
+++ b/drivers/fastboot/Kconfig
@@ -47,6 +47,13 @@ config TCP_FUNCTION_FASTBOOT
 	help
 	  This enables the fastboot protocol over TCP.
 
+config USB_EPMAXPACK_FASTBOOT
+	bool "Controls fastboot USB maxpacket size while receiving"
+	depends on USB_FUNCTION_FASTBOOT
+	default n
+	help
+	  This controls maxpacket on USB rx_bytes.
+
 if FASTBOOT
 
 config FASTBOOT_BUF_ADDR
diff --git a/drivers/usb/gadget/f_fastboot.c b/drivers/usb/gadget/f_fastboot.c
index 09e740cc96..ea503b651f 100644
--- a/drivers/usb/gadget/f_fastboot.c
+++ b/drivers/usb/gadget/f_fastboot.c
@@ -430,7 +430,11 @@ static unsigned int rx_bytes_expected(struct usb_ep *ep)
 {
 	int rx_remain = fastboot_data_remaining();
 	unsigned int rem;
-	unsigned int maxpacket = usb_endpoint_maxp(ep->desc);
+#if CONFIG_IS_ENABLED(USB_EPMAXPACK_FASTBOOT)
+ 	unsigned int maxpacket = ep->maxpacket; 
+#else
+    unsigned int maxpacket = usb_endpoint_maxp(ep->desc);
+ #endif
 
 	if (rx_remain <= 0)
 		return 0;
-- 
