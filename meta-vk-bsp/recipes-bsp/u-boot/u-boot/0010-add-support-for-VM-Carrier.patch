diff --git a/arch/arm/dts/vkcmg2lc.dtsi b/arch/arm/dts/vkcmg2lc.dtsi
index 0d1c8801ed..1dfed0ec95 100644
--- a/arch/arm/dts/vkcmg2lc.dtsi
+++ b/arch/arm/dts/vkcmg2lc.dtsi
@@ -1,10 +1,11 @@
-
 /dts-v1/;
 #include <dt-bindings/gpio/gpio.h>
 #include "r9a07g044c.dtsi"
 #include "r9a07g044c-u-boot.dtsi"
 #include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
 
+#define I2C3 0
+
 / {
         aliases {
                 serial0 = &scif0;
@@ -34,6 +35,13 @@
                          <RZG2L_PINMUX(26, 0, 1)>, /* ET0_RXD2 */
                          <RZG2L_PINMUX(26, 1, 1)>; /* ET0_RXD3 */
         };
+
+#if I2C3
+	i2c3_pins: i2c3 {
+                pinmux = <RZG2L_PINMUX(18, 0, 3)>,
+                         <RZG2L_PINMUX(18, 1, 3)>;
+        }; 
+#endif
 };
 
 &xinclk {
@@ -91,20 +99,6 @@
 		reg = <0x50>;
 		pagesize = <16>;
 	};
-
-	//pca9538: pca953x@70 {
-	//	compatible = "nxp,pca9538";
-	//	reg = <0x70>;
-	//	gpio-controller;
-	//	#gpio-cells = <2>;
-	//
-	//	sd-pwr-en-hog {
-	//		gpio-hog;
-	//		gpios = <6 GPIO_ACTIVE_HIGH>;
-	//		output-high;
-	//		line-name = "sd_pwr_en";
-	//	};
-	//};
 };
 
 &i2c1 {
@@ -112,6 +106,14 @@
         status = "okay";
 };
 
+#if I2C3
+&i2c3 {
+        pinctrl-0 = <&i2c3_pins>;
+        pinctrl-names = "default";
+        status = "okay";
+};
+#endif
+
 &spibsc {
         num-cs = <1>;
         status = "okay";
